{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zPy52/nabedra-database/docs/testing/evidence/schema.json",
  "title": "nabedra.evidence/1",
  "description": "One record per run and check, stored at docs/testing/evidence/records/<yyyy>/<mm>/<request_id>--<check>.json and kept under 20 KB. `kind` holds one or more check-kind letters separated by single spaces (a check that provides U and S writes \"U S\"). Logs and histories stay in Actions artifacts; `artifacts` lists their SHA-256 digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "check", "kind", "guarantees", "scenarios", "sha", "tree_clean", "build", "mode",
    "run", "duration_s", "result", "assertions", "seeds", "sim_core_hours", "virtual_hours",
    "artifacts"
  ],
  "properties": {
    "schema": {"type": "string", "const": "nabedra.evidence/1"},
    "check": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80},
    "kind": {"type": "string", "pattern": "^[MUSHFDRPKT]( [MUSHFDRPKT])*$"},
    "guarantees": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z]+(-[A-Z]+)*-G[0-9]{2}$"}
    },
    "scenarios": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 40}
    },
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_clean": {"type": "boolean"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "features", "binary_sha256"],
      "properties": {
        "profile": {"type": ["string", "null"], "maxLength": 40},
        "features": {"type": "array", "items": {"type": "string", "maxLength": 80}},
        "binary_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "mode": {
      "description": "Run mode and sampled configuration knobs, such as {\"direct_oltp\": true}. Null when the check has no mode.",
      "type": ["object", "null"],
      "additionalProperties": {"type": ["string", "boolean", "integer", "number"]}
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "attempt", "request_id", "runner", "date"],
      "properties": {
        "url": {"type": ["string", "null"], "pattern": "^https://", "maxLength": 300},
        "attempt": {"type": ["integer", "null"], "minimum": 1},
        "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 100},
        "runner": {"type": ["string", "null"], "maxLength": 100},
        "date": {"type": "string", "format": "date-time"}
      }
    },
    "duration_s": {"type": "number", "minimum": 0},
    "result": {"type": "string", "enum": ["pass", "fail", "not-run", "quarantined", "error"]},
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "failed", "not_run"],
      "properties": {
        "executed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "not_run": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": {"type": "string", "maxLength": 200},
              "reason": {"type": "string", "maxLength": 300}
            }
          }
        }
      }
    },
    "seeds": {
      "description": "Null for checks that use no seeds.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["range", "count", "failing"],
      "properties": {
        "range": {
          "type": ["array", "null"],
          "items": {"type": "integer", "minimum": 0},
          "minItems": 2,
          "maxItems": 2
        },
        "count": {"type": "integer", "minimum": 0},
        "failing": {"type": "array", "maxItems": 100, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "sim_core_hours": {"type": ["number", "null"], "minimum": 0},
    "virtual_hours": {"type": ["number", "null"], "minimum": 0},
    "s3_requests": {"type": "integer", "minimum": 0},
    "tla": {
      "description": "Kind T facts from scripts/testing/tla_check.py or tla_trace.py. Logs and counterexamples are artifacts.",
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "mode", "tier", "tools"],
      "properties": {
        "spec": {"type": "string", "maxLength": 160},
        "mode": {"type": "string", "enum": ["exhaustive", "simulation", "trace"]},
        "tier": {"type": "string", "enum": ["T0", "T1", "T2"]},
        "tools": {"type": "string", "maxLength": 120},
        "budget_s": {"type": "integer", "minimum": 0},
        "distinct_states": {"type": ["integer", "null"], "minimum": 0},
        "depth": {"type": ["integer", "null"], "minimum": 0},
        "states_generated": {"type": ["integer", "null"], "minimum": 0},
        "seed": {"type": "integer"},
        "behaviors": {"type": "integer", "minimum": 0},
        "actions": {"type": "integer", "minimum": 0},
        "min_action_coverage": {"type": ["integer", "null"], "minimum": 0},
        "uncovered": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 120}},
        "unmutated": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 120}},
        "limits": {"type": "array", "maxItems": 50, "description": "Constraints and overridden definitions the baselines declare, with the states each constraint kept.", "items": {"type": "string", "maxLength": 200}},
        "settings": {"type": "array", "maxItems": 80, "description": "One line per baseline (INIT, NEXT or SPECIFICATION, constants, constraints, symmetry) and per mutant (what it changes). summary.json has the full list.", "items": {"type": "string", "maxLength": 300}},
        "settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the full settings list in summary.json, as compact sorted JSON of Python's json.dumps."},
        "truncated": {"type": "boolean", "description": "Something was dropped or shortened to fit the record; `dropped` counts it and the summary.json artifact has it all."},
        "dropped": {
          "description": "How many entries of each list are not in this record: runs, failing_runs, controls, failing_controls, mutants, failing_mutants, failing_traces, uncovered, unmutated, limits, settings, not_run, artifacts, details (removed) and shortened (cut texts).",
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "runs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cfg", "verdict"],
            "properties": {
              "cfg": {"type": "string", "maxLength": 120},
              "verdict": {"type": "string", "maxLength": 40},
              "distinct_states": {"type": ["integer", "null"], "minimum": 0},
              "depth": {"type": ["integer", "null"], "minimum": 0},
              "states_left": {"type": ["integer", "null"], "minimum": 0},
              "duration_s": {"type": "number", "minimum": 0},
              "detail": {"type": "string", "maxLength": 300}
            }
          }
        },
        "controls": {
          "type": "array",
          "maxItems": 50,
          "description": "Runs of a mutant's cfg with the baseline's value of Mutant, which have to pass. A mutant names its control, or the baseline that is one.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cfg", "verdict"],
            "properties": {
              "cfg": {"type": "string", "maxLength": 128},
              "verdict": {"type": "string", "maxLength": 40},
              "distinct_states": {"type": ["integer", "null"], "minimum": 0},
              "depth": {"type": ["integer", "null"], "minimum": 0},
              "states_left": {"type": ["integer", "null"], "minimum": 0},
              "duration_s": {"type": "number", "minimum": 0},
              "detail": {"type": "string", "maxLength": 300}
            }
          }
        },
        "mutants": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expect", "observed", "ok", "cex_length"],
            "properties": {
              "name": {"type": "string", "maxLength": 120},
              "expect": {"type": "string", "maxLength": 120},
              "observed": {"type": "string", "maxLength": 120},
              "ok": {"type": "boolean"},
              "cex_length": {"type": ["integer", "null"], "minimum": 0},
              "control": {"type": "string", "maxLength": 128},
              "detail": {"type": "string", "maxLength": 300}
            }
          }
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "accepted", "rejected"],
          "properties": {
            "checked": {"type": "integer", "minimum": 0},
            "accepted": {"type": "integer", "minimum": 0},
            "rejected": {"type": "integer", "minimum": 0},
            "expected_rejections": {"type": "integer", "minimum": 0},
            "failing": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "reason"],
                "properties": {
                  "file": {"type": "string", "maxLength": 200},
                  "index": {"type": ["integer", "null"], "minimum": 0},
                  "reason": {"type": "string", "maxLength": 300}
                }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "maxLength": 200},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
