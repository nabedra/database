+/// Planted defect (land-sim, #179 review): from its first direct entry on, the worker holds
+/// one 692 B copy charged to its Data byte arena (Ledger::ChargedBytes("data")), not a scratch
+/// lease and not the route cache, for as long as its process runs.
+fn planted_charge(resources: &Arc<crate::oltp::pool::WorkerSharedResources>) {
+    use crate::oltp::pool::{ByteClass, WorkerSharedResources};
+    use std::sync::{Mutex, Weak};
+    static PLANTED: Mutex<Vec<Weak<WorkerSharedResources>>> = Mutex::new(Vec::new());
+    let worker = Arc::downgrade(resources);
+    let mut planted = PLANTED.lock().expect("planted charges");
+    if planted.iter().any(|of| of.ptr_eq(&worker)) {
+        return;
+    }
+    planted.push(worker.clone());
+    let Ok(charge) = resources.copy_bytes_in(ByteClass::Data, &[0u8; 692]) else {
+        return;
+    };
+    nabedra_rt::task::spawn(async move {
+        let _charge = charge;
+        while worker.strong_count() > 0 {
+            nabedra_rt::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+    });
+}
