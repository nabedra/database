+/// Planted defect: from its first direct entry on, the worker holds one working-memory lease
+/// of the size of a cached Control route (692 B), and never releases it. A baseline that let a
+/// route cache excuse its own size would hide it.
+fn planted_lease(resources: &Arc<crate::oltp::pool::WorkerSharedResources>) {
+    use crate::oltp::pool::{ByteClass, WorkerSharedResources};
+    use std::sync::{Mutex, Weak};
+    type Held = (Weak<WorkerSharedResources>, Box<dyn std::any::Any + Send>);
+    static PLANTED: Mutex<Vec<Held>> = Mutex::new(Vec::new());
+    let worker = Arc::downgrade(resources);
+    let mut planted = PLANTED.lock().expect("planted leases");
+    if planted.iter().any(|(of, _)| of.ptr_eq(&worker)) {
+        return;
+    }
+    if let Ok(lease) = resources.reserve_scratch(ByteClass::Data, 692) {
+        planted.push((worker, Box::new(lease)));
+    }
+}
