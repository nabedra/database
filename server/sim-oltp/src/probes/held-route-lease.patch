+/// Planted defect: from its first direct entry on, the worker holds one working-memory lease
+/// of the size of a cached Control route (692 B) for as long as its process runs. A baseline
+/// that let a route cache excuse its own size would hide it.
+fn planted_lease(resources: &Arc<crate::oltp::pool::WorkerSharedResources>) {
+    use crate::oltp::pool::{ByteClass, WorkerSharedResources};
+    use std::sync::{Mutex, Weak};
+    static PLANTED: Mutex<Vec<Weak<WorkerSharedResources>>> = Mutex::new(Vec::new());
+    let worker = Arc::downgrade(resources);
+    let mut planted = PLANTED.lock().expect("planted leases");
+    if planted.iter().any(|of| of.ptr_eq(&worker)) {
+        return;
+    }
+    planted.push(worker.clone());
+    let Ok(lease) = resources.reserve_scratch(ByteClass::Data, 692) else {
+        return;
+    };
+    // Held by a task of the worker's process, so it ends with the process or the run.
+    nabedra_rt::task::spawn(async move {
+        let _lease = lease;
+        while worker.strong_count() > 0 {
+            nabedra_rt::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+    });
+}
