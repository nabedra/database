# Equivalent predicates must return the same rows (TLP-style checks).

query rowsort label-le
{"op":"query.collect","table":"n","select":["id"],"filter":{"op":"le","column":"x","value":0}}

query rowsort label-le
{"op":"query.collect","table":"n","select":["id"],"filter":{"op":"not","arg":{"op":"gt","column":"x","value":0}}}

query rowsort label-le
{"op":"query.collect","table":"n","select":["id"],"filter":{"op":"or","args":[{"op":"lt","column":"x","value":0},{"op":"eq","column":"x","value":0}]}}

