artifact_bucket        = "replace-with-artifact-bucket"
backup_bucket          = "replace-with-backup-bucket"
backup_prefix          = "nabedra-events/orders"
backup_kms_key_arn     = "arn:aws:kms:us-east-1:111111111111:key/REPLACE"
metadata_voters        = [1, 2, 3]

brokers = {
