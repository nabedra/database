# Build context: the repository root. Send only what the root Dockerfile reads, so
# docs, plans, scripts and Events changes neither upload nor invalidate anything.
# Other builds from the root context (scripts/cache-benchmark) use .dockerignore.
*
!server/Cargo.toml
!server/Cargo.lock
!server/kv/Cargo.toml
!server/kv/src/
!server/check/Cargo.toml
!server/rt/Cargo.toml
!server/rt/src/
!server/protocol/Cargo.toml
!server/protocol/src/
!server/resources/Cargo.toml
!server/resources/src/
!server/oltp-types/Cargo.toml
!server/oltp-types/src/
!server/transport/Cargo.toml
!server/transport/src/
!server/transport/src/**
!server/oltp-storage/Cargo.toml
!server/oltp-storage/src/
!server/oltp-storage/src/**
!server/oltp-replication/Cargo.toml
!server/oltp-replication/src/
!server/oltp-replication/src/**
!server/sim/Cargo.toml
!server/sim-oltp/Cargo.toml
!server/src/
!orm/python/pyproject.toml
!orm/python/README.md
!orm/python/LICENSE
!orm/python/src/
**/__pycache__
**/*.egg-info
